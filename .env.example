# Copia este archivo como .env y completa lo que uses. Todo es opcional.
# Detalle de cada variable: docs/es/configuration.md (English: docs/en/configuration.md)

# ── Seguridad (recomendado si el servidor no es solo local) ──
TRACEREPORTS_TOKEN=
TRACEREPORTS_UI_USER=
TRACEREPORTS_UI_PASSWORD=
# Con token y sin login, el mismo equipo necesita credenciales para Ajustes; 1 lo permite (sin proxy)
# TRACEREPORTS_LOCAL_ADMIN=1
# Sin login, solo se atiende a localhost; otros nombres por los que entras (IP de la red, dominio):
# TRACEREPORTS_ALLOWED_HOSTS=reportes.lan,192.168.1.10
# Los clientes de tests leen TRACEREPORTS_TOKEN y TRACEREPORTS_URL de este mismo archivo si no están
# en el entorno (en CI, pásalos como secrets).
# Token restringido para CI: envía resultados y lee, pero no cambia Ajustes (distinto del anterior)
# TRACEREPORTS_INGEST_TOKEN=

# ── Diagnóstico con IA ──
# Lo más simple: una sola key y el proveedor se elige solo (Gemini tiene capa gratuita).
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
#
# O explícito: gemini | anthropic | openai | openai_compatible | ollama
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1
# AI_API_KEY=
# AI_BASE_URL=http://localhost:11434
#
# 1 = la pantalla de Ajustes no puede cambiar la IA (recomendado en servidores)
# TRACEREPORTS_SETTINGS_LOCKED=1
# Clave maestra para guardar CIFRADA la API key escrita en Ajustes (openssl rand -base64 32).
# Guárdala fuera de DATA_DIR: sin ella no se puede leer la key guardada.
# TRACEREPORTS_SECRET_KEY=

# Diagnósticos automáticos por ejecución (uno por resultado de cada test; 0 = sin límite)
# TRACEREPORTS_AI_MAX_PER_RUN=50
# Página de estado del proveedor que muestra Ajustes → Uso de la IA (formato Statuspage)
# TRACEREPORTS_AI_STATUS_URL=https://status.example.com/api/v2/summary.json

# ── Notificaciones al terminar cada ejecución ──
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
# URL pública del servidor, para el botón "Ver reporte"
PUBLIC_URL=
# always | failures
NOTIFY_ON=always
# Resumen de los últimos 7 días, cada semana (día sun…sat y hora del servidor)
# TRACEREPORTS_WEEKLY_SUMMARY=mon 09:00

# ── Tickets desde Escalar (un tracker aparece si tiene todas sus variables) ──
# TRACEREPORTS_GITHUB_REPO=owner/repo
# TRACEREPORTS_GITHUB_TOKEN=
# TRACEREPORTS_JIRA_URL=https://tuempresa.atlassian.net
# TRACEREPORTS_JIRA_PROJECT=SHOP
# TRACEREPORTS_JIRA_EMAIL=
# TRACEREPORTS_JIRA_TOKEN=
# TRACEREPORTS_AZURE_URL=https://dev.azure.com/tuorg
# TRACEREPORTS_AZURE_PROJECT=
# TRACEREPORTS_AZURE_TOKEN=

# ── Correlación con los logs del backend ({trace_id}, {request_id}, {from}, {to}…) ──
# TRACEREPORTS_TRACE_URL=https://jaeger.example.com/trace/{trace_id}
# TRACEREPORTS_LOGS_URL=https://logs.example.com/search?q={request_id}

# ── Equipo y release ──
# Dueños de los tests, como CODEOWNERS: archivo de reglas o reglas separadas por ;
# TRACEREPORTS_OWNERS_FILE=/config/OWNERS
# TRACEREPORTS_OWNERS=tests/checkout/* Pagos;tag:smoke @qa
# Criterios de la vista Release
# TRACEREPORTS_RELEASE_GATE=min_pass_rate=98; critical=smoke,checkout; max_new_failures=0; max_flaky=2

# ── Otros ──
# PORT=8080
# NETWORK_MAX_BODY_KB=256
# Horas sin recibir nada para cerrar como incompleta una ejecución abandonada (0 = nunca)
# TRACEREPORTS_STALE_RUN_HOURS=24
# Borra las ejecuciones (y sus capturas) de más de N días
# TRACEREPORTS_RETENTION_DAYS=90
# Más claves y headers que enmascarar, separados por coma
# TRACEREPORTS_REDACT_KEYS=rut,documento
# Solo si el servidor lo pide al arrancar (ver docs/es/configuration.md):
# TRACEREPORTS_AI_BUDGET_RECOVERY=backfill
# TRACEREPORTS_LEGACY_DB=ignore

# ── Clientes de tests (leen las TRACEREPORTS_* de este archivo si no están en el entorno) ──
# auto (graba si no hay servidor) | both (envía y además guarda una copia local) | always | off
# TRACEREPORTS_OFFLINE=both
# Carpeta donde cada corrida crea la suya (las rutas relativas son desde donde se lanzan los tests)
# TRACEREPORTS_OFFLINE_BASE=output/tracereports
# 1 = conservar también la grabación cruda (tiene datos sin enmascarar)
# TRACEREPORTS_OFFLINE_KEEP=1
