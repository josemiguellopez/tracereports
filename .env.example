# Copia este archivo como .env y completa lo que uses. Todo es opcional.
# Detalle de cada variable: docs/es/configuration.md (English: docs/en/configuration.md)

# ── Seguridad (recomendado si el servidor no es solo local) ──
TRACEREPORTS_TOKEN=
TRACEREPORTS_UI_USER=
TRACEREPORTS_UI_PASSWORD=
# Con token y sin login, el mismo equipo necesita credenciales para Ajustes; 1 lo permite (sin proxy)
# TRACEREPORTS_LOCAL_ADMIN=1
# Sin login, solo se atiende a localhost; otros nombres por los que entras (IP de la red, dominio):
# TRACEREPORTS_ALLOWED_HOSTS=reportes.lan,192.168.1.10
# Los clientes de tests leen TRACEREPORTS_TOKEN y TRACEREPORTS_URL de este mismo archivo si no están
# en el entorno (en CI, pásalos como secrets).
# Token restringido para CI: envía resultados y lee, pero no cambia Ajustes (distinto del anterior)
# TRACEREPORTS_INGEST_TOKEN=

# ── Diagnóstico con IA ──
# Lo más simple: una sola key y el proveedor se elige solo (Gemini tiene capa gratuita).
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
#
# O explícito: gemini | anthropic | openai | openai_compatible | ollama
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1
# AI_API_KEY=
# AI_BASE_URL=http://localhost:11434
#
# 1 = la pantalla de Ajustes no puede cambiar la IA (recomendado en servidores)
# TRACEREPORTS_SETTINGS_LOCKED=1
# Clave maestra para guardar CIFRADA la API key escrita en Ajustes (openssl rand -base64 32).
# Guárdala fuera de DATA_DIR: sin ella no se puede leer la key guardada.
# TRACEREPORTS_SECRET_KEY=

# ── Notificaciones al terminar cada ejecución ──
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
# URL pública del servidor, para el botón "Ver reporte"
PUBLIC_URL=
# always | failures
NOTIFY_ON=always

# ── Otros ──
# PORT=8080
# NETWORK_MAX_BODY_KB=256
# Horas sin recibir nada para cerrar como incompleta una ejecución abandonada (0 = nunca)
# TRACEREPORTS_STALE_RUN_HOURS=24
